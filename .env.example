# Copy to .env for `docker compose up`.
# Encrypts the *Arr API keys stored in SQLite. Generate with: openssl rand -base64 48
# If unset, a key file is created at $CONFIG_DIR/secret.key (mode 0600) instead.
FLEETARR_SECRET=
TZ=Europe/Riga
PUID=99
PGID=100

# Storage roots Fleetarr may inspect and modify, colon-separated like PATH.
# These must be the same container paths Radarr/Sonarr use. Empty = filesystem
# operations are disabled entirely (the UI says so and explains what to add).
FS_ROOTS=/data

# 002 keeps folders Fleetarr creates group-writable for the *Arr containers.
UMASK=002
